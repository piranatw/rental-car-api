{
  "name": "rental-car-api",
  "version": "1.0.0",
  "description": "Rental Car Booking REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "bash scripts/run-newman.sh",
    "demo": "newman run __tests__/demo.postman_collection.json -e __tests__/demo.postman_environment.json --env-var baseUrl=http://localhost:5050 --env-var adminEmail=$adminEmail --env-var adminPassword=$adminPassword --reporters cli",
    "demo:race": "bash scripts/demo-race.sh",
    "test:unit": "node --test \"__tests__/unit/*.test.js\"",
    "test:robustness": "bash scripts/run-robustness.sh"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "nodemon": "^3.1.14"
  }
}
