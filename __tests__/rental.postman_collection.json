{
  "info": {
    "name": "Rental Car Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-step: log in the seeded admin once and keep adminToken.",
          "if (!pm.environment.get('adminToken') && pm.environment.get('adminEmail') && pm.environment.get('adminPassword')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/api/v1/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({ email: pm.environment.get('adminEmail'), password: pm.environment.get('adminPassword') }) }",
          "  }, function (err, res) {",
          "    if (!err && res.code === 200) { pm.environment.set('adminToken', res.json().token); }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "register ok",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'user' + Date.now() + '@example.com';",
                  "pm.environment.set('userEmail', email);",
                  "pm.environment.set('userPassword', 'secret123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns 201 with token and no password', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.expect(JSON.stringify(body)).to.not.include('password');",
                  "});",
                  "pm.test('register ignores client-supplied role', function () {",
                  "  pm.expect(pm.response.json().data.role).to.eql('user');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test User\",\"telephone\":\"0812345678\",\"email\":\"{{userEmail}}\",\"password\":\"{{userPassword}}\",\"role\":\"admin\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "register duplicate email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate email returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test User\",\"telephone\":\"0812345678\",\"email\":\"{{userEmail}}\",\"password\":\"{{userPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "register missing telephone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing telephone returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"No Phone\",\"email\":\"nophone{{$timestamp}}@example.com\",\"password\":\"secret123\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "login wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('wrong password returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.environment.set('wrongPasswordMessage', pm.response.json().message);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{userEmail}}\",\"password\":\"wrong-password\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "login unknown email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unknown email returns 401 with the same message as wrong password', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.eql(pm.environment.get('wrongPasswordMessage'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"nobody{{$timestamp}}@example.com\",\"password\":\"whatever123\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "login ok",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200 and a token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.be.a('string');",
                  "});",
                  "pm.environment.set('userToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{userEmail}}\",\"password\":\"{{userPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "me with token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('me returns 200 with own email', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('userEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "me without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('me without token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "admin token obtained",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('collection pre-step logged in the admin', function () {",
                  "  pm.expect(pm.environment.get('adminToken')).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('admin me returns role admin', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "logout user register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('logoutEmail', 'logout' + Date.now() + '@example.com');",
                  "pm.environment.set('logoutPassword', 'secret123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('throwaway user registered', function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Logout User\",\"telephone\":\"0812345678\",\"email\":\"{{logoutEmail}}\",\"password\":\"{{logoutPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "logout user login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('throwaway login returns 200 and a token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().token).to.be.a('string');",
                  "});",
                  "pm.environment.set('logoutToken1', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{logoutEmail}}\",\"password\":\"{{logoutPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "logout without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout without token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout returns 200 with empty data', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.eql({});",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{logoutToken1}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "me with a garbage token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('garbage token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.environment.set('invalidStatus', pm.response.code);",
                  "pm.environment.set('invalidBody', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer not-a-real-token" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "me with the same token after logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('revoked token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('revoked response is identical to the garbage-token response', function () {",
                  "  pm.expect(pm.response.code).to.eql(Number(pm.environment.get('invalidStatus')));",
                  "  pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.environment.get('invalidBody')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{logoutToken1}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "logout again with the same token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('second logout with revoked token returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{logoutToken1}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "login again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login again returns 200 and a different token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const token = pm.response.json().token;",
                  "  pm.expect(token).to.be.a('string');",
                  "  pm.expect(token).to.not.eql(pm.environment.get('logoutToken1'));",
                  "  pm.environment.set('logoutToken2', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{logoutEmail}}\",\"password\":\"{{logoutPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "me with the new token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('new token returns 200 with own email', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.email).to.eql(pm.environment.get('logoutEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{logoutToken2}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "first token still rejected after second login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('first (revoked) token still returns 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('revoked response is identical to the garbage-token response', function () {",
                  "  pm.expect(pm.response.code).to.eql(Number(pm.environment.get('invalidStatus')));",
                  "  pm.expect(pm.response.json()).to.deep.eql(JSON.parse(pm.environment.get('invalidBody')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{logoutToken1}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    }
  ]
}
