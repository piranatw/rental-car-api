NODE_ENV=development
PORT=5050
# Local MongoDB. For Atlas use: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/rental_car_demo
# Demo value. Use a long random string anywhere that is not a demo.
JWT_SECRET=demo-secret-change-me-demo-secret-change-me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
# The admin account created on first start. The demo Postman environment uses the same pair.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123456
